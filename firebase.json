{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "hosting/public",
    "ignore": ["**/node_modules/**"],
    "rewrites": [
      { "source": "/invite/**", "destination": "/invite.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  }
}
